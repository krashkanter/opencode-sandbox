{
  "$schema": "https://opencode.ai/config.json",

  // Default model. The ":free" route draws on Token Harbor's rolling 7-day
  // allowance and is never billed; drop the suffix for the paid,
  // zero-data-retention route once the account has balance.
  "model": "tokenharbor/deepseek-v4.1-flash:free",

  "provider": {
    "tokenharbor": {
      // Token Harbor speaks the OpenAI chat-completions shape at /v1.
      "npm": "@ai-sdk/openai-compatible",
      "name": "Token Harbor",
      "options": {
        "baseURL": "https://tokenharbor.ai/v1",
        // Injected at runtime from .env — never written into this file.
        "apiKey": "{env:TOKENHARBOR_API_KEY}"
      },
      "models": {
        "deepseek-v4.1-flash": {
          "name": "DeepSeek V4.1 Flash",
          "limit": { "context": 1000000, "output": 65536 }
        },
        "deepseek-v4.1-flash:free": {
          "name": "DeepSeek V4.1 Flash (Free)",
          "limit": { "context": 1000000, "output": 65536 }
        }
      }
    }
  }
}
