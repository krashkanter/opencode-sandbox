# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Token Harbor gateway key. Create one at https://tokenharbor.ai/dashboard
# Format: thk_live_...
TOKENHARBOR_API_KEY=thk_live_replace_me

# Default model opencode boots with.
#   deepseek-v4.1-flash:free  -> free rolling 7-day allowance, never billed
#   deepseek-v4.1-flash       -> paid, zero-data-retention route (needs balance)
OPENCODE_MODEL=tokenharbor/deepseek-v4.1-flash:free

# Space-separated egress allowlist. The firewall resolves these to IPs and
# drops everything else. Add a domain here before expecting it to be reachable.
ALLOWED_DOMAINS=tokenharbor.ai opencode.ai registry.npmjs.org bun.sh api.github.com github.com objects.githubusercontent.com

# Resource ceilings for the sandbox container.
SANDBOX_CPUS=2
SANDBOX_MEMORY=4g
